{
  "name": "job-autopilot-desktop",
  "productName": "Job Autopilot",
  "version": "0.1.0",
  "description": "Finds jobs that fit you and applies to them, with a one-page resume assembled from your own approved content.",
  "author": "AntonyPerez0",
  "license": "MIT",
  "homepage": "https://github.com/AntonyPerez0/job-autopilot-desktop",
  "type": "module",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:unit": "node --test test/truth.test.js test/dedupe.test.js test/mail.test.js test/geo.test.js test/tailor.test.js test/facts.test.js test/llm.test.js",
    "e2e": "node test/e2e/onboarding.mjs",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "mammoth": "^1.13.0",
    "playwright-core": "^1.64.1",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false
  }
}
